# Construye el sitio y lo sirve desde el mismo Caddy que enruta el API,
# de modo que web y API comparten origen y no hace falta CORS.
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
# Vacio = mismo origen: el navegador pide /api/... al propio host.
ARG VITE_API_BASE=""
ENV VITE_API_BASE=$VITE_API_BASE
RUN npm run build

FROM caddy:2.10-alpine
COPY --from=build /app/dist /srv
COPY infra/Caddyfile /etc/caddy/Caddyfile
