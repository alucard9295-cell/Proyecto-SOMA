// Un solo Worker sirve la web (dist/) y el API (/api/*). Mismo origen: sin
// CORS ni VITE_API_BASE. Ver docs/SOMA-ADR-009-todo-cloudflare.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "soma",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    // SPA: cualquier ruta que no sea un archivo devuelve index.html.
    "not_found_handling": "single-page-application",
    // Solo el API pasa por el Worker; los estaticos no gastan invocaciones.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "soma",
      "database_id": "dee822f7-b0e8-4a78-bf4c-56e957a29c08",
      "migrations_dir": "migrations"
    }
  ],
  // R2 aun no esta habilitado en la cuenta (se activa en el dashboard). Sin
  // FILES, POST /api/admin/documentos responde 503. Al activarlo: descomentar.
  // "r2_buckets": [{ "binding": "FILES", "bucket_name": "soma-documentos" }],
  // Workers AI siempre corre en la cuenta, tambien en local (gasta neuronas).
  "ai": { "binding": "AI", "remote": true },
  // Asesor publico: 8 preguntas por minuto por IP. Contador aproximado y por
  // ubicacion de Cloudflare: frena abusos, no es una cuota exacta.
  "ratelimits": [{ "name": "ASESOR_LIMITE", "namespace_id": "1001", "simple": { "limit": 8, "period": 60 } }],
  "vars": {
    "ENVIRONMENT": "production",
    // Cloudflare Access: equipo y audiencia de la aplicacion que protege
    // /admin y /api/admin/*. Vacios = el API de admin responde 503 (falla
    // cerrado). En local, .dev.vars pone ENVIRONMENT=development.
    // No son secretos: van aqui con su valor real. `wrangler deploy` pisa con
    // lo de este archivo cualquier valor puesto a mano en el dashboard.
    // ADMIN_EMAILS (quien es admin) es secreto: `wrangler secret put ADMIN_EMAILS`.
    // Sin el, el admin tambien responde 503.
    "ACCESS_TEAM_DOMAIN": "divine-bread-e664.cloudflareaccess.com",
    "ACCESS_AUD": "c333a1af825d11b568c00db982b00287480cc89b912d6be864fcf7c070bdea60",
    // Panel de consumo del plan gratis. El token (Account Analytics: Read) es
    // secreto: `wrangler secret put CF_ANALYTICS_TOKEN`. Sin el, el panel
    // explica como crearlo y solo muestra el cupo del asesor.
    "CF_ACCOUNT_ID": "ade189f7e45e0b5576eb5c4db1229591"
  },
  "observability": { "enabled": true }
}
