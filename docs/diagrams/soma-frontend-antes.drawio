        <!-- ================= RESUMEN ================= -->
        <mxCell id="resumen" value="Consecuencias observables&#10;&#10;1. Dos pestañas y un botón fallaban con error de red al usarlos.&#10;2. El Resumen mostraba ceros aunque hubiera datos.&#10;3. El precio del APU podía cambiar al guardarlo (dos fórmulas).&#10;4. El botón Atrás del navegador no hacía nada.&#10;5. Volver de ventas obligaba a iniciar sesión de nuevo.&#10;6. El panel de resultados del simulador se veía mal (CSS pisado).&#10;7. La Orientación explicaba módulos que no existían." style="shape=note;whiteSpace=wrap;html=1;size=18;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="900" y="720" width="330" height="200" as="geometry" />
        </mxCell>

        <mxCell id="leyenda" value="Cómo se corrigió&#10;&#10;53ba756 → se ocultan las pestañas sin backend + test de contrato&#10;7f293ed → domain/costing.py: una sola fórmula + /apus/preview&#10;0afb762 → popstate, textos en YAML, widget flotante, CSS&#10;d4c33fe → salida a ventas desde el login, reinicio del asesor" style="shape=note;whiteSpace=wrap;html=1;size=18;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
