{
  "name": "soma",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p . && tsc -p tsconfig.node.json",
    "db:migrate:local": "wrangler d1 migrations apply soma --local",
    "db:migrate:remote": "wrangler d1 migrations apply soma --remote",
    "deploy": "npm run typecheck && npm test && vite build && wrangler deploy"
  },
  "dependencies": {
    "@ag-ui/client": "^1.0.0",
    "@copilotkit/react-core": "^1.73.3",
    "@hono/zod-validator": "^0.9.1",
    "ai": "^7.0.114",
    "big.js": "^7.0.1",
    "hono": "^4.13.9",
    "jose": "^6.2.12",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rehype-harden": "1.1.8",
    "streamdown": "1.6.11",
    "workers-ai-provider": "^4.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.59.0",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260924.1",
    "@rollup/plugin-yaml": "^5.0.0",
    "@types/big.js": "^7.0.0",
    "@types/node": "^24.13.6",
    "@vitejs/plugin-react": "^6.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.138.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20260921.1": true
  }
}
